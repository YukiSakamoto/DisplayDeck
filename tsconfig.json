{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "strictFunctionTypes": true,
  },
  "include": ["src"]
}
